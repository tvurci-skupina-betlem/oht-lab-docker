# Vaultwarden stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

VAULTWARDEN_IMAGE_TAG=1.37.5-alpine

# Bind only to localhost by default.
# Caddy runs on another host (CT 104), so production uses the docker3 LAN IP.
VAULTWARDEN_BIND_IP=127.0.0.1
VAULTWARDEN_PORT=8081

# Public URL, must match the Caddy / Cloudflare hostname exactly.
VAULTWARDEN_DOMAIN=https://vault.betlem.cloud

# UID/GID that owns the data directory on the host.
PUID=1000
PGID=1000

# SQLite data on local disk (not CephFS), outside the Komodo checkout.
VAULTWARDEN_DATA_ROOT=/opt/appdata/vaultwarden
# Nightly archives on CephFS.
VAULTWARDEN_BACKUP_ROOT=/mnt/cephfs/appdata/vaultwarden/backups
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=30

# Set to true only while creating the first account, then back to false.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true

# Optional settings below are passed to the container only when defined.
# Leave them commented out (not empty) when unused: an empty SMTP_HOST=
# makes Vaultwarden refuse to start.

# Admin panel, disabled while unset. Generate an Argon2 PHC hash with
#   docker exec -it vaultwarden /vaultwarden hash
# and wrap it in single quotes so Compose does not expand the $ signs.
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$...'

# Push notifications for mobile apps (https://bitwarden.com/host).
# For an EU installation id use https://api.bitwarden.eu and
# https://identity.bitwarden.eu.
# PUSH_ENABLED=true
# PUSH_INSTALLATION_ID=
# PUSH_INSTALLATION_KEY=
# PUSH_RELAY_URI=https://push.bitwarden.com
# PUSH_IDENTITY_URI=https://identity.bitwarden.com

# SMTP for invitations, email 2FA and new device notices.
# SMTP_HOST=mail-eu.smtp2go.com
# SMTP_FROM=vault@betlem.cloud
# SMTP_FROM_NAME=OHT Vaultwarden
# SMTP_PORT=2525
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=

LOG_LEVEL=warn
