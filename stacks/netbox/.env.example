# NetBox stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague
TIME_ZONE=Europe/Prague

NETBOX_IMAGE_TAG=v4.6-5.0.1

# Bind only to localhost by default.
# If Caddy is on another host, change to 0.0.0.0 or a specific docker3 LAN IP.
NETBOX_BIND_IP=0.0.0.0
NETBOX_PORT=8000

# Persistent data root on the deployment node.
NETBOX_APPDATA_ROOT=/mnt/cephfs/appdata/netbox

# Public URL after reverse proxy is configured.
ALLOWED_HOSTS=netbox.betlem.cloud localhost

POSTGRES_DB=netbox
POSTGRES_USER=netbox

# Generate all secret values before deployment:
# openssl rand -base64 32
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-base64-32
REDIS_PASSWORD=change-me-generate-with-openssl-rand-base64-32
REDIS_CACHE_PASSWORD=change-me-generate-with-openssl-rand-base64-32

# Generate with:
# openssl rand -base64 64
SECRET_KEY=change-me-generate-with-openssl-rand-base64-64
API_TOKEN_PEPPER_1=change-me-generate-with-openssl-rand-base64-64

# First boot admin bootstrap. Rotate after initial setup if desired.
SKIP_SUPERUSER=false
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@betlem.cloud
SUPERUSER_PASSWORD=change-me-generate-with-openssl-rand-base64-32
SUPERUSER_API_TOKEN=change-me-generate-with-openssl-rand-base64-32
SUPERUSER_API_KEY=change-me-generate-with-openssl-rand-base64-32

EMAIL_FROM=info@betlem.cloud
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=change-me-google-workspace-email-address
EMAIL_PASSWORD=change-me-google-workspace-app-password
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
