# Technitium DNS example environment (primary on docker5).
# Configure these in Komodo; never commit real secrets.

TZ=Europe/Prague
TECHNITIUM_IMAGE_TAG=15.6.2
TECHNITIUM_HOSTNAME=technitium-primary
TECHNITIUM_ADMIN_PASSWORD=change-me
TECHNITIUM_WEB_ADDRESSES=192.168.50.105,127.0.0.1
TECHNITIUM_WEB_PORT=5380
TECHNITIUM_RECURSION=AllowOnlyForPrivateNetworks
TECHNITIUM_BLOCK_LIST_URLS=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts,https://raw.githubusercontent.com/Mondrogar/pihole-czech-block-list/refs/heads/master/turris-hole-czech-block-list
TECHNITIUM_DATA_ROOT=/opt/appdata/technitium
TECHNITIUM_LOG_DAYS=7
TECHNITIUM_STATS_DAYS=30
