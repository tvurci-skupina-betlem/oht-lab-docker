# Beszel hub example environment.
# Configure these in Komodo; never commit real secrets.

TZ=Europe/Prague
BESZEL_IMAGE_TAG=0.21.2

# Caddy runs on CT 104, so production binds the docker3 LAN IP.
BESZEL_BIND_IP=127.0.0.1
BESZEL_PORT=8090
BESZEL_APP_URL=https://beszel.betlem.cloud

# First admin user, created only on a fresh install.
BESZEL_USER_EMAIL=admin@betlem.cloud
BESZEL_USER_PASSWORD=change-me

# PocketBase data (SQLite) on local disk.
BESZEL_DATA_ROOT=/opt/appdata/beszel
