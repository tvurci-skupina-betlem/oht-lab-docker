# Diode server example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets. Generate each secret with: openssl rand -hex 32

TZ=Europe/Prague

DIODE_IMAGE_TAG=2.3.2
DIODE_BIND_IP=192.168.50.203
DIODE_PORT=8080
DIODE_APPDATA_ROOT=/opt/appdata/diode
DIODE_LOGGING_LEVEL=INFO

# NetBox Diode plugin API, as reached from the Diode reconciler container.
NETBOX_DIODE_PLUGIN_API_BASE_URL=http://192.168.50.203:8000/api/plugins/diode

DIODE_REDIS_PASSWORD=change-me
DIODE_POSTGRES_ADMIN_PASSWORD=change-me
DIODE_POSTGRES_PASSWORD=change-me
DIODE_HYDRA_POSTGRES_PASSWORD=change-me
DIODE_HYDRA_SECRETS_SYSTEM=change-me-at-least-32-characters

# OAuth2 clients. NETBOX_TO_DIODE_CLIENT_SECRET must also be set on the NetBox
# stack. Each Orb Agent gets its own ingest client: "client_id=secret" pairs.
DIODE_TO_NETBOX_CLIENT_SECRET=change-me
NETBOX_TO_DIODE_CLIENT_SECRET=change-me
DIODE_INGEST_CLIENTS="orb-docker3=change-me"
