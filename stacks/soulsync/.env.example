# SoulSync stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# No secrets here: service credentials are entered in the web UI and stored
# in config/config.json under SOULSYNC_DATA_ROOT.

TZ=Europe/Prague

SOULSYNC_IMAGE_TAG=3.6.5

# Bind only to localhost by default.
# Caddy runs on another host (CT 104), so production uses the docker2 LAN IP.
SOULSYNC_BIND_IP=127.0.0.1
SOULSYNC_PORT=8008

# UID/GID that owns the data and media directories.
PUID=1000
PGID=1000
UMASK=022

# Config and SQLite databases on local disk, outside the Komodo checkout.
SOULSYNC_DATA_ROOT=/opt/appdata/soulsync
# Downloads, staging and the music library on CephFS.
SOULSYNC_MEDIA_ROOT=/mnt/cephfs/appdata/soulsync

SOULSYNC_LOG_LEVEL=INFO
