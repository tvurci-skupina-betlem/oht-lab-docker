# Forgejo stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

# 15.x is the LTS line. Keep the -rootless suffix.
FORGEJO_IMAGE_TAG=15.0.12-rootless

# Bind only to localhost by default.
# Caddy runs on another host (CT 104), so production uses the docker4 LAN IP.
FORGEJO_BIND_IP=127.0.0.1
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222

# Public URL host, must match the Caddy / Cloudflare hostname exactly.
FORGEJO_DOMAIN=git.betlem.cloud
# Host shown in SSH clone URLs. Cloudflare Tunnel and Caddy carry only HTTPS,
# so SSH works only on the LAN / tailnet, straight to docker4.
FORGEJO_SSH_DOMAIN=192.168.50.204
FORGEJO_APP_NAME=Forgejo

# UID/GID that owns the data directory on the host (rootless image = 1000).
PUID=1000
PGID=1000

# SQLite, repositories, LFS and app.ini on local disk (not CephFS).
FORGEJO_DATA_ROOT=/opt/appdata/forgejo
# Nightly `forgejo dump` archives on CephFS.
FORGEJO_BACKUP_ROOT=/mnt/cephfs/appdata/forgejo/backups
# UTC (the backup script's date has no zoneinfo in this image).
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14

FORGEJO_DISABLE_REGISTRATION=true
FORGEJO_REQUIRE_SIGNIN_VIEW=false
FORGEJO_DEFAULT_USER_VISIBILITY=public
FORGEJO_DEFAULT_ORG_VISIBILITY=public
# last | private | public
FORGEJO_DEFAULT_PRIVATE=private

FORGEJO_LOG_LEVEL=Info

# Optional: any other app.ini key as FORGEJO__<section>__<KEY>.
# Leave them commented out when unused. Example: mail through smtp2go.
# FORGEJO__mailer__ENABLED=true
# FORGEJO__mailer__PROTOCOL=smtp+starttls
# FORGEJO__mailer__SMTP_ADDR=mail-eu.smtp2go.com
# FORGEJO__mailer__SMTP_PORT=2525
# FORGEJO__mailer__FROM=Forgejo <git@betlem.cloud>
# FORGEJO__mailer__USER=
# FORGEJO__mailer__PASSWD=
