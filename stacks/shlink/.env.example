# Shlink stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

SHLINK_IMAGE_TAG=5.1.9
SHLINK_WEB_CLIENT_IMAGE_TAG=4.9.1
POSTGRES_IMAGE_TAG=18.7-alpine

# Bind only to localhost by default.
# Caddy runs on another host (CT 104), so production uses the docker-ha1 LAN IP.
SHLINK_BIND_IP=127.0.0.1
SHLINK_HTTP_PORT=8080
SHLINK_WEB_CLIENT_PORT=8081

# Short URL domain, must match the Caddy / Cloudflare hostname exactly.
SHLINK_DEFAULT_DOMAIN=hlav.ac
# Proxies whose X-Forwarded-For entries are trusted: Caddy (CT 104) and
# the two cloudflared connectors (CT 106, CT 107).
SHLINK_TRUSTED_PROXIES=192.168.50.115,192.168.50.63,192.168.50.98

POSTGRES_DB=shlink
POSTGRES_USER=shlink
POSTGRES_PASSWORD=change-me

# Admin API key created on the first start only. Any random string (UUID).
SHLINK_INITIAL_API_KEY=
# MaxMind GeoLite2 license key (free account). Empty = no visit geolocation.
SHLINK_GEOLITE_LICENSE_KEY=

SHLINK_SHORT_CODES_LENGTH=5
# 301/308 are cached by browsers forever; 302 keeps links editable.
SHLINK_REDIRECT_STATUS_CODE=302
SHLINK_BASE_URL_REDIRECT=
SHLINK_INVALID_URL_REDIRECT=

# Postgres data and pg_dump archives, on the CT 205 rootfs (Ceph RBD).
SHLINK_DATA_ROOT=/opt/appdata/shlink
BACKUP_HOUR=03
BACKUP_KEEP_DAYS=14
