# Dashboards dev example environment. The services extend the Homepage,
# Glance and Dynacat production definitions, so all of their variables
# (see ../homepage, ../glance, ../dynacat .env.example) apply here too.
# Komodo stack `dashboards-dev` holds the real values.

DEV_BIND_IP=127.0.0.1
DEV_CONFIG_ROOT=/opt/dashdev
HOMEPAGE_DEV_PORT=3010
GLANCE_DEV_PORT=8083
DYNACAT_DEV_PORT=8085
HOMEPAGE_DEV_ALLOWED_HOSTS=homepage-dev.betlem.cloud
DYNACAT_DEV_TITLE=OHT-LAB (Dynacat dev)
