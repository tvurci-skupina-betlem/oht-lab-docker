# Spotizerr Phoenix stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

SPOTIZERR_IMAGE_TAG=4.0.17
REDIS_IMAGE_TAG=8.6.8-alpine

# Bind only to localhost by default.
# Caddy runs on another host (CT 104), so production uses the docker2 LAN IP.
SPOTIZERR_BIND_IP=127.0.0.1
SPOTIZERR_PORT=7171

# Public URL, used for FRONTEND_URL and the SSO callback.
SPOTIZERR_URL=https://spotizerr.betlem.cloud

# UID/GID that owns the data and downloads directories.
PUID=1000
PGID=1000
UMASK=0022

# App state on local disk, outside the Komodo checkout.
SPOTIZERR_DATA_ROOT=/opt/appdata/spotizerr
# Music library on CephFS.
SPOTIZERR_DOWNLOADS_ROOT=/mnt/cephfs/appdata/spotizerr/downloads

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=change-me
JWT_SECRET=change-me

ENABLE_AUTH=true
JWT_EXPIRATION_HOURS=720
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
DISABLE_REGISTRATION=true

# Optional Google SSO. Redirect URI to register in Google Cloud:
#   https://spotizerr.betlem.cloud/api/auth/sso/callback
SSO_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

EXPLICIT_FILTER=false
LOG_LEVEL=info
