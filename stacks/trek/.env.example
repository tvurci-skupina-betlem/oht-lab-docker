# TREK stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

# Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Bind only to localhost by default.
# If Caddy is on another host, change to 0.0.0.0 or a specific docker2 LAN IP.
TREK_BIND_IP=127.0.0.1
TREK_PORT=3000

# Public URL after reverse proxy is configured.
APP_URL=https://trek.betlem.cloud

# Comma-separated allowed origins if needed.
ALLOWED_ORIGINS=https://trek.betlem.cloud

LOG_LEVEL=info

# Behind Caddy / Cloudflare / another TLS-terminating proxy.
TRUST_PROXY=1
FORCE_HTTPS=false

# OpenIDConnect (OIDC)
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_DISPLAY_NAME=Google