# Orb Agent stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

ORB_AGENT_IMAGE_TAG=2.8.0
ORB_AGENT_NAME=orb-docker3
ORB_APPDATA_ROOT=/mnt/cephfs/appdata/orb
ORB_SOURCE_CONFIG_DIR=/opt/stacks/komodo-periphery/data/stacks/orb/stacks/orb/config

# Keep dry-run enabled until Diode and NetBox ingestion are confirmed.
DIODE_DRY_RUN=true
DIODE_DRY_RUN_OUTPUT_DIR=/opt/orb/output

# Diode ingestion settings. Leave placeholders until the Diode service is ready.
DIODE_TARGET=grpc://127.0.0.1:8080/diode
DIODE_CLIENT_ID=change-me-diode-client-id
DIODE_CLIENT_SECRET=change-me-diode-client-secret
