# Orb Agent stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

ORB_AGENT_IMAGE_TAG=2.8.0
ORB_AGENT_NAME=orb-docker3
ORB_APPDATA_ROOT=/mnt/cephfs/appdata/orb

# Discovery scope for this site. Targets: comma-separated IPs, ranges or CIDRs.
ORB_SCAN_TARGETS=192.168.50.0/24
ORB_NETWORK_MASK=24
ORB_TENANT=OHT-LAB
ORB_SCAN_SCHEDULE=0 */6 * * *
ORB_SCAN_TIMEOUT=10

# Keep dry-run enabled until Diode and NetBox ingestion are confirmed.
DIODE_DRY_RUN=true
DIODE_DRY_RUN_OUTPUT_DIR=/opt/orb/output

# Diode ingestion. The client ID and secret must be one of the pairs in the
# Diode stack's DIODE_INGEST_CLIENTS.
DIODE_TARGET=grpc://192.168.50.203:8080/diode
DIODE_CLIENT_ID=orb-docker3
DIODE_CLIENT_SECRET=change-me
