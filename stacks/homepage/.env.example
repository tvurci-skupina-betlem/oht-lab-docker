# Homepage stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

HOMEPAGE_IMAGE_TAG=v1.13.1
DOCKER_SOCKET_PROXY_IMAGE_TAG=v0.4.1

# Bind only to localhost by default in compose.yml.
# If Caddy is on another host, change to 0.0.0.0 or a specific docker1 LAN IP.
HOMEPAGE_BIND_IP=192.168.50.203
HOMEPAGE_PORT=3000

# Required by Homepage v1.0+ for every hostname used to access the UI.
# Comma-separated, no spaces.
HOMEPAGE_ALLOWED_HOSTS=homepage.betlem.cloud

# User used by the Homepage container for config file access.
PUID=1000
PGID=1000

LOG_TARGETS=stdout

# Proxmox service widget.
# Create a Proxmox API token and use "user@realm!token-id" as the username.
# Keep the real token secret in Komodo or the deployment host .env only.
HOMEPAGE_VAR_PROXMOX_URL=https://lab.betlem.cloud
HOMEPAGE_VAR_PROXMOX_USERNAME=homepage@pam!homepage
HOMEPAGE_VAR_PROXMOX_PASSWORD=change-me-proxmox-api-token-secret
