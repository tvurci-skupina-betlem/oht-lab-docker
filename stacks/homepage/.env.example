# Homepage stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Never commit real secrets.

TZ=Europe/Prague

HOMEPAGE_IMAGE_TAG=v1.13.1
DOCKER_SOCKET_PROXY_IMAGE_TAG=v0.4.1

# Bind only to localhost by default in compose.yml.
# If Caddy is on another host, change to 0.0.0.0 or a specific docker1 LAN IP.
HOMEPAGE_BIND_IP=192.168.50.203
HOMEPAGE_PORT=3000

# Required by Homepage v1.0+ for every hostname used to access the UI.
# Comma-separated, no spaces.
HOMEPAGE_ALLOWED_HOSTS=homepage.betlem.cloud

# User used by the Homepage container for config file access.
PUID=1000
PGID=1000

LOG_TARGETS=stdout

# Proxmox service widget.
# Create a Proxmox API token and use "user@realm!token-id" as the username.
# Keep the real token secret in Komodo or the deployment host .env only.
HOMEPAGE_VAR_PROXMOX_URL=https://lab.betlem.cloud
HOMEPAGE_VAR_PROXMOX_USERNAME=homepage@pam!homepage
HOMEPAGE_VAR_PROXMOX_PASSWORD=change-me-proxmox-api-token-secret

# qBittorrent widget on OHT-NAS1.
# Keep the real password in Komodo (variable HOMEPAGE_QBITTORRENT_PASSWORD).
HOMEPAGE_VAR_QBITTORRENT_USERNAME=admin
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=change-me-qbittorrent-password

# Komodo widget (stack health). Create an API key in Komodo settings
# (a read-only service user is enough). Keep real values in Komodo variables
# HOMEPAGE_KOMODO_API_KEY / HOMEPAGE_KOMODO_API_SECRET.
HOMEPAGE_VAR_KOMODO_KEY=K-change-me
HOMEPAGE_VAR_KOMODO_SECRET=S-change-me

# Pi-hole v6 widgets. Use an app password from each Pi-hole
# (Settings > Web interface / API > Configure app password).
# Keep real values in Komodo variables HOMEPAGE_PIHOLE_PRIMARY_APP_PASSWORD /
# HOMEPAGE_PIHOLE_SECONDARY_APP_PASSWORD.
HOMEPAGE_VAR_PIHOLE_PRIMARY_KEY=change-me-pihole-primary-app-password
HOMEPAGE_VAR_PIHOLE_SECONDARY_KEY=change-me-pihole-secondary-app-password

# Uptime Kuma widget reads one status page: http://<kuma>/status/<slug>.
HOMEPAGE_VAR_UPTIMEKUMA_SLUG=oht-lab

# Home Assistant widget: long-lived access token
# (HA profile > Security > Long-lived access tokens).
HOMEPAGE_VAR_HOMEASSISTANT_TOKEN=change-me-ha-long-lived-token

# Tailscale widget: API access token (Tailscale admin console > Settings > Keys).
# Tailscale API keys expire after at most 90 days.
HOMEPAGE_VAR_TAILSCALE_API_KEY=tskey-api-change-me

# Cloudflare Tunnel widget: API token with Account > Cloudflare Tunnel > Read.
HOMEPAGE_VAR_CLOUDFLARE_API_TOKEN=change-me-cloudflare-api-token
