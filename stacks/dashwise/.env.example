# Dashwise example environment.
# Configure these in Komodo; never commit real secrets.

TZ=Europe/Prague
DASHWISE_IMAGE_TAG=v1.0-rc2

# Caddy runs on CT 104, so production binds the docker3 LAN IP.
DASHWISE_BIND_IP=127.0.0.1
DASHWISE_PORT=3016
DASHWISE_URL=https://dashwise.betlem.cloud
DASHWISE_INSTANCE_NAME=OHT-LAB

# Bundled PocketBase superuser (also the first Dashwise admin).
DASHWISE_ADMIN_EMAIL=admin@betlem.cloud
DASHWISE_ADMIN_PASSWORD=change-me

# Set to true once your own account exists.
DASHWISE_DISABLE_SIGNUP=false

# PocketBase data (users, dashboards, links, integrations) on local disk.
DASHWISE_DATA_ROOT=/opt/appdata/dashwise
DASHWISE_LOG_LEVEL=info
