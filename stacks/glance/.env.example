# Glance example environment.
# Configure these in Komodo; never commit real secrets.

TZ=Europe/Prague
GLANCE_IMAGE_TAG=v0.8.8
DOCKER_SOCKET_PROXY_IMAGE_TAG=v0.4.1

# Caddy runs on CT 104, so production binds the docker3 LAN IP.
GLANCE_BIND_IP=127.0.0.1
GLANCE_PORT=8082
GLANCE_TITLE=OHT-LAB

# Proxmox API token (same read-only token as Homepage): user@realm!tokenid
PROXMOX_URL=https://lab.betlem.cloud
PROXMOX_TOKEN_ID=homepage@pam!homepage
PROXMOX_TOKEN_SECRET=change-me

# Komodo read-only API key (same as Homepage).
KOMODO_URL=https://komodo.betlem.cloud
KOMODO_API_KEY=change-me
KOMODO_API_SECRET=change-me

# Beszel read-only dashboard user.
BESZEL_URL=https://beszel.betlem.cloud
BESZEL_USER=dashboards@betlem.cloud
BESZEL_PASSWORD=change-me

# Pi-hole v6 app passwords (same as Homepage).
PIHOLE_PRIMARY_PASSWORD=change-me
PIHOLE_SECONDARY_PASSWORD=change-me
