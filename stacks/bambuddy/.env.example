# Bambuddy stack example environment.
# Copy to .env on the deployment host or configure variables in Komodo.
# Bambuddy needs no secrets at deploy time; printer access codes are stored
# in the app database after first login.

TZ=Europe/Prague

# Pin the image version; bump deliberately via pull request.
BAMBUDDY_IMAGE_TAG=1.2.5.7

# Bind only to localhost by default.
# In Komodo this is set to the docker2 LAN IP so Caddy can reach it.
BAMBUDDY_BIND_IP=127.0.0.1
BAMBUDDY_PORT=8000

# Container drops privileges to this user after fixing volume ownership.
PUID=1000
PGID=1000

# Scheduled backup target. On OHT-LAB this is CephFS appdata.
BAMBUDDY_BACKUP_ROOT=./backups
