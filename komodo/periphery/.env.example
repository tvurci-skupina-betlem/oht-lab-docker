# Komodo Periphery example environment.
# Copy to .env next to compose.yml on each Docker node.
# Never commit real keys or passkeys.

KOMODO_PERIPHERY_IMAGE_TAG=2

# Must match the host path mounted into the container (same path both sides).
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

PERIPHERY_BIND_IP=0.0.0.0
PERIPHERY_PORT=8120
PERIPHERY_SSL_ENABLED=true

# Komodo v2: paste the Core public key from Komodo Settings (starts with MCow...).
PERIPHERY_CORE_PUBLIC_KEYS=
# Legacy v1 passkey auth. Leave empty when using public keys.
PERIPHERY_PASSKEYS=

PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
